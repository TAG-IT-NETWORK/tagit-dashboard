# TAG IT Business — local environment
# Copy to .env.local and fill in. All NEXT_PUBLIC_* vars are exposed to the browser.

# WalletConnect / RainbowKit project id (https://cloud.reown.com). Optional —
# without it, only injected wallets (MetaMask) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base Sepolia RPC. Optional — falls back to the public https://sepolia.base.org.
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# ── Sign-in and the services key (server-side only, TAP-T17) ─────────────────
# Brand users sign in with Google. With any of the three AUTH_ values missing
# the app still serves the landing page and keeps everything else closed.
# AUTH_SECRET must be this app's OWN secret, never the console's: a session
# made here must not be accepted there.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# tagit-services address and key. The key is read only in src/lib/roster.ts
# (who is this email?) and src/lib/brand-services.ts (every call is made
# under the signed-in user's brand). It never reaches the browser.
SERVICES_URL=https://api.tagit.network
SERVICES_API_KEY=
# This app still holds NO relayer key and has no bind routes (TAP-T01): tags
# are attached at the binding station in the TAG IT console. Do not add
# RELAYER_API_KEY here.

# ── Lead capture (server-side only — NOT exposed to the browser) ─────────────
# /api/demo-request stores demo requests. Configure at least one sink for
# production; with none configured the route accepts+logs in dev but returns
# 503 in production (fail closed — never silently drop a lead).
# Generic JSON webhook (Zapier/Make/…); hooks.slack.com URLs get Slack {text}.
LEADS_WEBHOOK_URL=
# Notion sink: internal-integration secret + the page (shared with the
# integration) under which each lead is created as a child page.
NOTION_API_KEY=
NOTION_LEADS_PARENT_PAGE_ID=
