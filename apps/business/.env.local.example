# TAG IT Business — local environment
# Copy to .env.local and fill in. All NEXT_PUBLIC_* vars are exposed to the browser.

# WalletConnect / RainbowKit project id (https://cloud.reown.com). Optional —
# without it, only injected wallets (MetaMask) are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Base Sepolia RPC. Optional — falls back to the public https://sepolia.base.org.
NEXT_PUBLIC_BASE_SEPOLIA_RPC=

# ── Bind relayer (server-side only — NOT exposed to the browser) ──────────────
# The /api/bind and /api/bind/status routes proxy to tagit-services so the API
# key never reaches the client. For a Vercel deploy, TAGIT_SERVICES_URL must be a
# PUBLIC url — localhost is only reachable in local dev.
TAGIT_SERVICES_URL=http://localhost:3100
TAGIT_SERVICES_API_KEY=

# ── Session / auth gateway (server-side only — NOT exposed to the browser) ────
# HS256 secret shared with tagit-services. MUST be byte-identical on both sides,
# or the Edge middleware + bind relay will reject every session. Keep it secret.
SESSION_JWT_SECRET=

# Gateway mode. "false" (default) = REPORT-ONLY: log would-be denies but allow,
# so false 401s surface before enforcing. "true" = ENFORCE: 401/redirect.
AUTH_ENFORCE=false

# Canonical auth domain (where sign-in lives), e.g. pro.tagit.network.
AUTH_DOMAIN=pro.tagit.network

# Cookie domain for the tagit_session cookie (leave blank for host-only in dev),
# e.g. .tagit.network to share the session across subdomains.
COOKIE_DOMAIN=

# Privy app id (https://dashboard.privy.io) — enables the "Create a wallet" email
# on-ramp on the sign-in screen. Without it, only "Connect a wallet" is offered.
# Requires the @privy-io/react-auth provider (wired in a follow-up).
NEXT_PUBLIC_PRIVY_APP_ID=

# ── Lead capture (server-side only — NOT exposed to the browser) ─────────────
# /api/demo-request stores demo requests. Configure at least one sink for
# production; with none configured the route accepts+logs in dev but returns
# 503 in production (fail closed — never silently drop a lead).
# Generic JSON webhook (Zapier/Make/…); hooks.slack.com URLs get Slack {text}.
LEADS_WEBHOOK_URL=
# Notion sink: internal-integration secret + the page (shared with the
# integration) under which each lead is created as a child page.
NOTION_API_KEY=
NOTION_LEADS_PARENT_PAGE_ID=

# ── USDC billing (T6b — Buy credits) ─────────────────────────────────────────
# Treasury that receives the USDC top-up. MUST match the services
# BILLING_TREASURY / SALE_TREASURY, or the server rejects the payment.
NEXT_PUBLIC_SALE_TREASURY=0x458B4d0c3a55006965Fd13D6af7B8509De51Cb3D
# Fixed top-up price (USDC). MUST match the services BILLING_TOPUP_USDC.
NEXT_PUBLIC_BILLING_TOPUP_USDC=10
