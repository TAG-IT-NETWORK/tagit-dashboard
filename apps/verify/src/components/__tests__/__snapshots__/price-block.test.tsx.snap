// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PriceBlock — rendered-output snapshots > EUR: two-decimal fx approximation renders '≈ €66.54' with the approx marker 1`] = `"<p class="text-[13px] leading-[18px] text-muted" data-price-approx="true"><span aria-label="Approximately 66.54 EUR, converted amount — approximate, not the charged price">≈ €66.54</span> <span aria-hidden="true">(approx.)</span></p>"`;

exports[`PriceBlock — rendered-output snapshots > JPY: zero-decimal fx approximation renders '≈ ¥12366' with no invented fraction 1`] = `"<p class="text-[13px] leading-[18px] text-muted" data-price-approx="true"><span aria-label="Approximately 12366 JPY, converted amount — approximate, not the charged price">≈ ¥12366</span> <span aria-hidden="true">(approx.)</span></p>"`;
