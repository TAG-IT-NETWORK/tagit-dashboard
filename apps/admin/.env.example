# apps/admin environment (META-T32)
# Copy to .env.local for development. Everything here is SERVER-SIDE ONLY —
# nothing below may ever be prefixed NEXT_PUBLIC_.

# ── Auth (NextAuth v5 / Auth.js, Google sign-in) ─────────────────────────────
# OAuth client from Google Cloud console → APIs & Services → Credentials
# (Web application; redirect URI: {origin}/api/auth/callback/google).
# The code builds and unit-tests WITHOUT these — they are asserted per-request.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Session JWT encryption secret: `openssl rand -base64 32`
AUTH_SECRET=
# Only needed off-Vercel (local prod builds): the canonical deployment origin.
# AUTH_URL=http://localhost:3001

# NOTE: SITE_PASSWORD is RETIRED (META-T32). Access is now Google sign-in +
# per-path roles from the tagit-services admin_users roster
# (viewer | operator | admin — see src/lib/rbac.ts).

# ── tagit-services upstream (server proxies inject these; keys never reach the browser)
SERVICES_URL=https://api.tagit.network
SERVICES_API_KEY=
# Mint broadcasts a relayer transaction — mint-proxy needs the relayer tier too.
RELAYER_API_KEY=
